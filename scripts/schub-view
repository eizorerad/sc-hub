#!/bin/sh
# Your sc-hub dashboard on this computer (http://sc-hub.localhost:27182): starts it in the background if it is
# not running, then opens it. It keeps running until you stop it or restart the computer.
#
#   ~/.sc-hub/bin/schub-view            start and open
#   ~/.sc-hub/bin/schub-view status     (and stop, serve, --once)
#
# The dashboard itself is schub_view.py next to this file (the setup installs both in ~/.sc-hub/bin). It needs
# Python 3.9+: the one the setup used first (written in below), then python3 or python, then uv (which fetches one).
set -eu
HERE="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$HERE/schub_view.py"
PINNED="__PYTHON__"
for candidate in "$PINNED" python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
    exec "$candidate" "$SCRIPT" "$@"
  fi
done
PATH="$HOME/.local/bin:$PATH"
if command -v uv >/dev/null 2>&1; then
  exec uv run --no-project --python 3.12 python "$SCRIPT" "$@"
fi
echo "sc-hub: the dashboard needs Python 3.9 or newer, or uv (https://docs.astral.sh/uv/)" >&2
exit 1
